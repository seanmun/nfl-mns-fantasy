{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "api/_*.ts,src/lib/**/*.ts",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-lines",
      "schedule": "0 10 * * 2"
    },
    {
      "path": "/api/cron/tick",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api|@|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
